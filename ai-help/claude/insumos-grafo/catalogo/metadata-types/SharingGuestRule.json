    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- No arquivo sharingRules/<Objeto>.sharingRules, este conteúdo fica no elemento <sharingGuestRules> -->\n<SharingGuestRule xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <fullName>[Nome_Da_Regra]</fullName>\n    <accessLevel>Read</accessLevel>\n    <label>[rótulo]</label>\n    <sharedTo>\n        <guestUser>[apelido do guest user]</guestUser>\n    </sharedTo>\n    <criteriaItems>\n        <field>[campo]</field>\n        <operation>equals</operation>\n        <value>[valor]</value>\n    </criteriaItems>\n    <includeHVUOwnedRecords>false</includeHVUOwnedRecords>\n</SharingGuestRule>",
