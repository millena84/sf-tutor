  "exemplo_xml": {
    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- No arquivo sharingRules/<Objeto>.sharingRules, este conteúdo fica no elemento <sharingCriteriaRules> -->\n<SharingCriteriaRule xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <fullName>[Nome_Da_Regra]</fullName>\n    <accessLevel>Read</accessLevel>\n    <label>[rótulo]</label>\n    <sharedTo>\n        <group>[Nome_Do_Grupo]</group>\n    </sharedTo>\n    <criteriaItems>\n        <field>[campo]</field>\n        <operation>equals</operation>\n        <value>[valor]</value>\n    </criteriaItems>\n    <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>\n</SharingCriteriaRule>",
