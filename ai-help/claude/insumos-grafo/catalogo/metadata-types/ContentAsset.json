    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- Arquivo -meta.xml que acompanha o arquivo .asset -->\n<ContentAsset xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <language>[idioma do rótulo]</language>\n    <masterLabel>[rótulo do asset]</masterLabel>\n    <relationships>\n        <organization>\n            <!-- Valores documentados: VIEWER, COLLABORATOR, INFERRED -->\n            <access>VIEWER</access>\n        </organization>\n    </relationships>\n    <versions>\n        <version>\n            <number>1</number>\n            <pathOnClient>[nome original do arquivo]</pathOnClient>\n        </version>\n    </versions>\n</ContentAsset>",
