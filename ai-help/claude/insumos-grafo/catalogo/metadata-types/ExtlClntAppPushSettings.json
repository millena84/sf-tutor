  "exemplo_xml": {
    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ExtlClntAppPushSettings xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <!-- Obrigatório -->\n    <externalClientApplication>[Nome do external client app associado]</externalClientApplication>\n    <!-- Obrigatório. Valores: Apple, Android -->\n    <pushServiceType>Apple</pushServiceType>\n    <!-- Condicional (um entre androidPushConfig, applePushConfig e pushConfigLink):\n        <androidPushConfig>\n        <fcmProject>[Id do projeto Google Firebase do app]</fcmProject>\n        <serviceAccount>[Chave privada do Admin SDK da conta de serviço do Firebase, em base64 (até 8.000 caracter…]</serviceAccount>\n        </androidPushConfig>\n    -->\n    <!-- Condicional (um entre androidPushConfig, applePushConfig e pushConfigLink):\n        <applePushConfig>\n        <environment>Production</environment>\n        </applePushConfig>\n    -->\n    <!-- Condicional (um entre androidPushConfig, applePushConfig e pushConfigLink):\n        <pushConfigLink>[Aponta uma configuração existente (orgId:recordId); gerado ao criar com configuração embu…]</pushConfigLink>\n    -->\n</ExtlClntAppPushSettings>",
