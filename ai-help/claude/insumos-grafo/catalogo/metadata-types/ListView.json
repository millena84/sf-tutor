  "exemplo_xml": {
    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- No arquivo .object do objeto, este conteúdo fica no elemento <listViews> -->\n<ListView xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <fullName>[Nome_Da_List_View]</fullName>\n    <columns>NAME</columns>\n    <!-- Valores documentados incluem: Everything, Mine, Queue -->\n    <filterScope>Everything</filterScope>\n    <filters>\n        <field>[campo]</field>\n        <operation>equals</operation>\n        <value>[valor]</value>\n    </filters>\n    <label>[nome da list view]</label>\n</ListView>",
    "natureza": "didatico_projeto",
    "nota": "Exemplo escrito pelo projeto apenas com elementos documentados; sem dados reais."
  }
