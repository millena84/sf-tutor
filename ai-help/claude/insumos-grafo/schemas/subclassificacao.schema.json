{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subclassificacao.schema.json",
  "title": "subclassificacao",
  "type": "object",
  "required": [
    "id",
    "nome",
    "classificacao",
    "natureza",
    "descricao",
    "funcionalidades",
    "estado"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sub:[a-z0-9-]+$"
    },
    "nome": {
      "type": "string"
    },
    "sigla": {
      "type": "string"
    },
    "classificacao": {
      "type": "string"
    },
    "natureza": {
      "enum": [
        "curadoria_didatica",
        "agrupamento_documental_oficial"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "funcionalidades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estado": {
      "$ref": "comum.schema.json#/$defs/estado"
    },
    "nota_estado": {
      "type": "string"
    }
  }
}