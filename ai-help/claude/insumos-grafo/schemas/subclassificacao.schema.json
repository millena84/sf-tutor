{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subclassificacao.schema.json",
  "title": "subclassificacao",
  "type": "object",
  "required": [
    "id",
    "nome",
    "classificacao",
    "natureza",
    "descricao",
    "escopo",
    "fora_do_escopo",
    "funcionalidades",
    "estado"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sub:[a-z0-9-]+$"
    },
    "nome": {
      "type": "string"
    },
    "sigla": {
      "type": "string"
    },
    "classificacao": {
      "type": "string"
    },
    "natureza": {
      "enum": [
        "curadoria_didatica",
        "agrupamento_documental_oficial"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "escopo": {
      "type": "string",
      "minLength": 20,
      "description": "Critério de inclusão do tema (curadoria didática do projeto)."
    },
    "fora_do_escopo": {
      "type": "string",
      "minLength": 20,
      "description": "O que fica fora do tema e em qual tema procurar."
    },
    "funcionalidades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referencias_oficiais": {
      "$ref": "comum.schema.json#/$defs/evidencias"
    },
    "estado": {
      "$ref": "comum.schema.json#/$defs/estado"
    },
    "nota_estado": {
      "type": "string"
    }
  }
}
