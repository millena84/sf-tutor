{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salesforce.schema.json",
  "title": "salesforce",
  "type": "object",
  "required": [
    "id",
    "nome",
    "o_que_e",
    "conceitos",
    "organizacao_do_mapa",
    "como_navegar",
    "nuvens",
    "classificacoes",
    "versao_base",
    "estado"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^salesforce$"
    },
    "nome": {
      "type": "string"
    },
    "nota_logo": {
      "type": "string"
    },
    "o_que_e": {
      "type": "string"
    },
    "conceitos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "termo",
          "definicao"
        ],
        "additionalProperties": false,
        "properties": {
          "termo": {
            "type": "string"
          },
          "definicao": {
            "type": "string"
          },
          "analogia": {
            "type": "string"
          },
          "limite_analogia": {
            "type": "string"
          }
        }
      }
    },
    "organizacao_do_mapa": {
      "type": "string"
    },
    "relacoes_entre_produtos": {
      "type": "string"
    },
    "como_navegar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nuvens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classificacoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versao_base": {
      "type": "object"
    },
    "estado": {
      "$ref": "comum.schema.json#/$defs/estado"
    },
    "evidencias": {
      "$ref": "comum.schema.json#/$defs/evidencias"
    }
  }
}