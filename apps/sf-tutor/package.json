{
  "name": "sf-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tutorial visual e navegável em grafo do ecossistema Salesforce (consome ai-help/claude/insumos-grafo/gerado/site).",
  "scripts": {
    "dados": "node scripts/preparar-dados.mjs",
    "dados:sem-validar": "node scripts/preparar-dados.mjs --sem-validar",
    "dev": "npm run dados && vite",
    "build": "npm run dados && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "tsc --noEmit && eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "perf": "node scripts/fixture-sintetica.mjs dist/__teste-sintetico && playwright test --project=perf",
    "verificar": "npm run build && npm run lint && npm test && npm run test:e2e && npm run perf"
  },
  "dependencies": {
    "cytoscape": "^3.34.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
